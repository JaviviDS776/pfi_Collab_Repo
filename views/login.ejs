<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/login.css">
  <title>Login Form</title>
</head>

<body>
  <% if (error) { %>
    <div class="error-message">
      <div>
        <span>¡Error!</span>
        <p>
          <%= error %>
        </p>
      </div>
    </div>
    <% } %>



      <div class="container">
        <div class="left-side">
          <div class="welcome-text">Bienvenido!</div>
          <div class="account-text">¿Aún no tienes una cuenta?</div>
          <a href="/register" class="register-btn" id="register-btn">Registrate</a>
        </div>
        <div class="right-side">
          <h1>Inicio de sesión</h1>
          <div class="user-icon">
            <svg width="200" height="200" viewBox="0 0 147 147" fill="none" xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink">
              <rect width="147" height="147" fill="url(#pattern0_123_230)" />
              <defs>
                <pattern id="pattern0_123_230" patternContentUnits="objectBoundingBox" width="1" height="1">
                  <use xlink:href="#image0_123_230" transform="scale(0.01)" />
                </pattern>
                <image id="image0_123_230" width="100" height="100" preserveAspectRatio="none"
                  xlink:href="data:image/png;base64," />
              </defs>
            </svg>
          </div>
          <form action="/login" method="post">
            <div class="form-group">
              <label for="username">Usuario:</label>
              <input type="text" id="username" name="username" placeholder="Usuario">
            </div>
            <div class="form-group">
              <label for="password">Contraseña:</label>
              <input type="password" id="password" name="password" placeholder="Contraseña"
                pattern="^(?=.*[A-Z])(?=.*[!@#$%^&*()_+\-=\[\]{};':&quot;\\|,.<>\/?]).{8,}$">
            </div>
            <button type="submit">Iniciar sesión</button>
          </form>
        </div>
      </div>
</body>

</html>

<script>
  document.getElementById('register-btn').addEventListener('click', function () {
    document.body.classList.add('fade-in');
    setTimeout(function () {
      window.location.href = '/register';
    }, 1000);  // Esperar que la animación termine
  });
</script>